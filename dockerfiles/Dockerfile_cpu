# 3.10 floor: the code uses typing.Annotated (py3.9+), and matches the
# python version in the TRT image's base (nvcr tensorrt 23.05 / Ubuntu 22.04).
FROM python:3.10-slim

ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8
ENV PIP_INSTALL="python -m pip --no-cache-dir install --upgrade"

RUN apt-get update &&\
    apt-get install -y\
            libgl1 \
            protobuf-compiler \
            libprotoc-dev \
            libb64-0d \
            libglib2.0-0 \
            libgomp1 \
            gcc \
            curl  \
            libturbojpeg0 \
            git &&\
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN $PIP_INSTALL -r requirements.txt

WORKDIR /app
COPY if_rest /app/if_rest
COPY entrypoint.sh /app/entrypoint.sh

# Bake in the model manifest and the /health self-check images so the image
# is self-contained for k8s. Compose bind-mounts ../models over /models, so
# this stays compatible with local development; in-cluster, only the model
# cache dirs are volume-mounted (PVC) and models.json is read from the image.
COPY models/models.json /models/models.json
COPY misc/test_images /images/test_images


ENTRYPOINT [ "bash" ]
CMD ["entrypoint.sh"]
